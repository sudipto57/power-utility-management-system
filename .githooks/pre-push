#!/bin/sh
# Runs before every push: checks the files of every commit that is about to go to GitHub.
# See tools/privacy-check.mjs. GitHub runs the same check again (.github/workflows/checks.yml).
status=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) node tools/privacy-check.mjs --tree "$local_sha" || status=1 ;;
    *) ;; # a branch is being deleted: nothing to check
  esac
done
exit $status
