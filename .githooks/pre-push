#!/bin/sh
# Runs before every push: checks what EVERY commit that is about to go to GitHub added or changed,
# so private data that was added in one commit and deleted in a later one is stopped too.
# See tools/privacy-check.mjs. GitHub runs the same check again (.github/workflows/checks.yml).
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue # a branch is being deleted: nothing to check
  fi
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
    # the branch is already on GitHub: check the new commits only
    node tools/privacy-check.mjs --commits "$remote_sha..$local_sha" || status=1
  else
    # a new branch: check every commit that is not on GitHub yet
    node tools/privacy-check.mjs --commits "$local_sha" --not --remotes || status=1
  fi
  node tools/privacy-check.mjs --tree "$local_sha" || status=1
done
exit $status
