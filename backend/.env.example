# Copy this file to backend/.env and fill in YOUR values.
# backend/.env is secret: it is in .gitignore and must NEVER go to GitHub.
# This example file is public, so it only has placeholders - never put real values here.
# On Render, type the same names and values on the service's "Environment" page instead.

PORT=5000

# Database (Supabase -> Project Settings -> Database -> Connection pooler)
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_SSL=true

# Login tokens. Make a long random secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-text
JWT_EXPIRES_IN=1d

# Websites allowed to call this API (comma separated, no slash at the end)
CLIENT_URL=http://localhost:5173

# Emails (confirmation codes, password reset codes, new bills) - free Brevo account:
#   brevo.com -> Senders, Domains & IPs -> add and verify your sender email
#   brevo.com -> SMTP & API -> API Keys -> Generate a new API key
# Leave BREVO_API_KEY empty on your computer: the emails are then printed in the terminal.
BREVO_API_KEY=
EMAIL_FROM=your-verified-sender@gmail.com
EMAIL_FROM_NAME=Power Utility Management System
# Where the website feedback form sends messages (leave empty = the EMAIL_FROM inbox)
FEEDBACK_EMAIL=
# Website address used for the buttons inside emails (your Vercel address when it is live)
APP_URL=http://localhost:5173

# Copy every website sign-up into database/04_sample_data.sql (true on your computer).
# On Render set it to false: the hosting site has no copy of your project folder to write to.
SAVE_CUSTOMERS_TO_SQL_FILE=true

# On Render set NODE_ENV=production (turns on HTTPS-only headers and checks the JWT_SECRET length)
NODE_ENV=development
